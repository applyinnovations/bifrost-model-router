{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "config_store": { "enabled": false },
  "logs_store": { "enabled": false },
  "client": {
    "allow_direct_keys": true,
    "disable_content_logging": true,
    "enable_logging": true
  },
  "providers": {
    "openai": { "keys": [] },
    "managed": {
      "keys": [{
        "name": "managed",
        "value": "env.MANAGED_PROVIDER_API_KEY",
        "models": ["*"],
        "weight": 1
      }]
    }
  },
  "plugins": [{
    "enabled": true,
    "name": "codex-model-router",
    "path": "./lib/codex-model-router.so",
    "config": {
      "version": 1,
      "instructions_template": "You are a coding agent.",
      "image_generation_model": "openai/gpt-6-luna",
      "providers": {
        "openai": { "credential_mode": "request_passthrough", "responses_mode": "native", "discover_models": true },
        "managed": { "credential_mode": "bifrost", "responses_mode": "chat_polyfill", "adapter": "single-system-message", "discover_models": true, "codex_defaults": { "context_window": 131072, "input_modalities": ["text"] } }
      },
      "models": {
        "openai/gpt-example": { "aliases": ["gpt-example"], "codex": { "context_window": 128000 } },
        "openai/gpt-6-luna": { "aliases": ["gpt-6-luna"], "codex": { "context_window": 272000 } },
        "managed/example-model": { "aliases": ["example-model"], "codex": { "context_window": 131072 } }
      }
    }
  }]
}
