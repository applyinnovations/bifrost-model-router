{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/applyinnovations/bifrost-model-router/config/router.schema.json",
  "title": "Bifrost Codex model router configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers", "models"],
  "properties": {
    "version": { "const": 1 },
    "instructions_template": { "type": "string" },
    "hosted_tool_fallback_model": { "type": "string", "minLength": 1 },
    "providers": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/provider" } },
    "models": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[^/]+/.+$" }, "additionalProperties": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "responsesMode": { "enum": ["native", "chat_polyfill", "unsupported"] },
    "adapter": { "enum": ["native", "openai-chat", "single-system-message", "strict-text-only"] },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_mode", "responses_mode"],
      "properties": {
		"display_name": { "type": "string", "minLength": 1 },
        "credential_mode": { "enum": ["bifrost", "request_passthrough"] },
        "responses_mode": { "$ref": "#/$defs/responsesMode" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "native_hosted_tools": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "discover_models": { "type": "boolean" },
		"model_name_overrides": {
		  "type": "object",
		  "propertyNames": { "minLength": 1 },
		  "additionalProperties": { "type": "string", "minLength": 1 }
		},
        "codex_defaults": { "$ref": "#/$defs/codex" }
      }
    },
    "reasoningLevel": {
      "type": "object", "additionalProperties": false, "required": ["effort"],
      "properties": {
        "effort": { "enum": ["minimal", "low", "medium", "high", "xhigh"] },
        "description": { "type": "string" }
      }
    },
    "codex": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "context_window": { "type": "integer", "minimum": 1 },
        "max_context_window": { "type": "integer", "minimum": 1 },
        "effective_context_window_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "default_reasoning_level": { "type": "string" },
        "supported_reasoning_levels": { "type": "array", "items": { "$ref": "#/$defs/reasoningLevel" } },
        "input_modalities": { "type": "array", "items": { "enum": ["text", "image"] }, "uniqueItems": true },
        "supports_reasoning_summaries": { "type": "boolean" },
        "supports_verbosity": { "type": "boolean" },
        "supports_search": { "type": "boolean" },
        "supports_image_detail_original": { "type": "boolean" },
        "truncation_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "contextVariant": {
      "type": "object", "additionalProperties": false, "required": ["context_window"],
      "properties": {
        "context_window": { "type": "integer", "minimum": 1000, "multipleOf": 1000 },
        "effective_context_window_percent": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["codex"],
      "properties": {
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "provider": { "type": "string", "minLength": 1 },
        "upstream_model": { "type": "string", "minLength": 1 },
        "responses_mode": { "$ref": "#/$defs/responsesMode" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "codex": { "$ref": "#/$defs/codex" },
        "context_variants": { "type": "array", "items": { "$ref": "#/$defs/contextVariant" }, "uniqueItems": true }
      }
    }
  }
}
